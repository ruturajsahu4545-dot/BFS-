
def print_board(board):
    for row in board:
        print(" ".join(row))


def is_safe(board, row, col):
    # Check left side of the same row
    for j in range(col):
        if board[row][j] == 'Q':
            return False

    # Check upper-left diagonal
    i, j = row - 1, col - 1
    while i >= 0 and j >= 0:
        if board[i][j] == 'Q':
            return False
        i -= 1
        j -= 1

    # Check lower-left diagonal
    i, j = row + 1, col - 1
    while i < 8 and j >= 0:
        if board[i][j] == 'Q':
            return False
        i += 1
        j -= 1

    return True


def solve(board, col):
    # All queens have been placed
    if col == 8:
        return True

    # Try every row in this column
    for row in range(8):
        if is_safe(board, row, col):
            board[row][col] = 'Q'

            if solve(board, col + 1):
                return True

            # Backtrack
            board[row][col] = '.'

    return False


board = [['.' for _ in range(8)] for _ in range(8)]

if solve(board, 0):
    print("Solution exists:")
    print_board(board)
else:
    print("No solution exists.")

